# Copy to .env for local development with `netlify dev`, or set these in
# Netlify → Site configuration → Environment variables. Never commit real
# values.

# Required. Used by every stage.
ANTHROPIC_API_KEY=

# Optional Stage 3 (Test) source keys. Any that are missing just mean that
# source runs on its lower unauthenticated limits, or is skipped and listed
# as skipped under "Where we looked".

# GitHub issue search: any read-only token. Raises the search limit from
# about 10 to 30 requests a minute.
GITHUB_TOKEN=

# Stack Exchange: a free app key from stackapps.com (not a secret). Raises
# the quota from 300 to 10,000 requests a day.
STACKEXCHANGE_KEY=

# Bluesky search no longer works without an account. Use an app password
# (Settings → Privacy and security → App passwords), never the main one.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# NVD CVE database: optional key, raises 5 to 50 requests per 30 seconds.
NVD_API_KEY=

# Semantic Scholar: free key on request. Without one it often returns
# "rate limited", and Test carries on without it.
SEMANTIC_SCHOLAR_API_KEY=
